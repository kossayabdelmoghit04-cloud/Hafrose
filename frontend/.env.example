# ─────────────────────────────────────────────────────────────
# HAFROSE Frontend — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# API Base URL (Laravel Backend)
VITE_API_BASE_URL=http://localhost:8000/api

# Laravel Storage Base URL (for media file URLs)
VITE_STORAGE_URL=http://localhost:8000/storage

# App Environment
VITE_APP_ENV=development

# Cloudflare Turnstile public site key only (never put the secret in Vite).
# Use an official Cloudflare test site key for local/test environments.
VITE_TURNSTILE_SITE_KEY=

# Playwright E2E certification accounts (local/test environment only)
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_CUSTOMER_B_EMAIL=
E2E_CUSTOMER_B_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_API_URL=http://127.0.0.1:8000
