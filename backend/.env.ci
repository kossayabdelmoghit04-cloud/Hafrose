APP_NAME=Hafrose
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_FROM_ADDRESS="ci@hafrose.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD — Désactiver les services externes
# ─────────────────────────────────────────────────────────────────────────────
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000000000000

HONEYPOT_ENABLED=false
HONEYPOT_FIELD=website

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD — Monitoring (désactivé en CI)
# ─────────────────────────────────────────────────────────────────────────────
MONITORING_ENABLED=false
MONITORING_HEALTH_ENABLED=false
MONITORING_METRICS_ENABLED=false
MONITORING_LOG_CHANNEL=stderr
MONITORING_SLOW_REQUEST_THRESHOLD=5000
MONITORING_SLOW_QUERY_THRESHOLD=2000
MONITORING_MEMORY_WARNING=90.0
MONITORING_DISK_WARNING=90.0
MONITORING_DISK_CRITICAL=95.0
MONITORING_CPU_WARNING=90.0
MONITORING_SCHEDULER_ENABLED=false
MONITORING_QUEUE_ENABLED=false
MONITORING_CACHE_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD — Backup (désactivé)
# ─────────────────────────────────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_PATH=backups
BACKUP_DATABASE=false
BACKUP_STORAGE=false
BACKUP_IMAGES=false
BACKUP_COMPRESS=false

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD — Maintenance (désactivée)
# ─────────────────────────────────────────────────────────────────────────────
MAINTENANCE_SECRET=ci-maintenance-secret
MAINTENANCE_ALLOWED_IPS=127.0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD — Scheduler (désactivé)
# ─────────────────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD — Santé système (désactivée)
# ─────────────────────────────────────────────────────────────────────────────
HEALTH_CHECK_ENABLED=false
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
