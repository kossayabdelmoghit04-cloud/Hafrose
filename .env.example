# ==============================================================================
# HAFROSE — Docker Production Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure production values.
# NEVER commit .env to version control.
# ==============================================================================

# Application
APP_NAME=Hafrose
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hafrose.com
APP_KEY=
LOG_LEVEL=info

# Database (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hafrose
DB_USERNAME=hafrose
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Session, Cache, Queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Security & CORS
CORS_ALLOWED_ORIGINS=https://hafrose.com,https://www.hafrose.com,https://api.hafrose.com
FRONTEND_URL=https://hafrose.com
SANCTUM_EXPIRATION=480
SANCTUM_CUSTOMER_EXPIRATION=480
SANCTUM_ADMIN_EXPIRATION=120

# Frontend Build Arguments
VITE_API_BASE_URL=/api
VITE_STORAGE_URL=/storage
VITE_APP_ENV=production
