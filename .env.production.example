# Copy to .env.production on the target host. Never commit that real file.
IMAGE_TAG=0000000000000000000000000000000000000000
BACKEND_IMAGE_REPOSITORY=registry.example.invalid/hafrose/backend
FRONTEND_IMAGE_REPOSITORY=registry.example.invalid/hafrose/frontend
BIND_ADDRESS=0.0.0.0

APP_NAME=HAFROSE
APP_ENV=production
APP_DEBUG=false
APP_KEY=GENERATE_AT_PROVISIONING
APP_URL=https://api.example.invalid
FRONTEND_URL=https://www.example.invalid
APP_TIMEZONE=UTC
TRUSTED_PROXIES=172.16.0.0/12

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=REPLACE_AT_PROVISIONING
DB_USERNAME=REPLACE_AT_PROVISIONING
DB_PASSWORD=REPLACE_AT_PROVISIONING
MYSQL_ROOT_PASSWORD=REPLACE_AT_PROVISIONING

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_AT_PROVISIONING
MAIL_PORT=587
MAIL_USERNAME=REPLACE_AT_PROVISIONING
MAIL_PASSWORD=REPLACE_AT_PROVISIONING
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME=HAFROSE

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=REPLACE_AT_PROVISIONING
TURNSTILE_SECRET_KEY=REPLACE_AT_PROVISIONING
VITE_TURNSTILE_SITE_KEY=REPLACE_AT_PROVISIONING
VITE_API_BASE_URL=/api
VITE_STORAGE_URL=/storage

CORS_ALLOWED_ORIGINS=https://www.example.invalid
SANCTUM_STATEFUL_DOMAINS=www.example.invalid
SANCTUM_EXPIRATION=480
SANCTUM_CUSTOMER_EXPIRATION=480
SANCTUM_ADMIN_EXPIRATION=120
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=info

BACKUP_ENABLED=true
BACKUP_DATABASE=true
BACKUP_STORAGE=true
BACKUP_IMAGES=true
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=
OFFSITE_ENABLED=false
OFFSITE_DISK=
OFFSITE_PREFIX=hafrose
SCHEDULER_ENABLED=true
SCHEDULER_BACKUP_TIME=02:00
